# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Google Maps (client supplies a billed key; Maps JavaScript API enabled) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=  # Optional Map ID required for Advanced Markers (from Google Maps Platform > Map Management)

# --- Support / Inquiry Email (leave blank to open mailto with empty recipient) ---
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Event Configuration ---
NEXT_PUBLIC_EVENT_TIMEZONE=PDT


# --- Data source: the live Google Sheet (remote-first; OFFLINE/ files are archived) ---
GOOGLE_SHEETS_SPREADSHEET_ID=19Xs3TScHhS369n_A8VvUGxszoxncx1p32T8iwNHSKTU
# Tab names the loader reads (supports wildcards e.g. Locations*, ROS by TIME*):
SHEETS_TAB_LOCATIONS=Locations*
SHEETS_TAB_PERSONNEL=Personnel*
SHEETS_TAB_DEPARTMENTS=Departments*
SHEETS_TAB_ACTIONS=Actions*
SHEETS_TAB_ROS=ROS by TIME*

# --- Google Sheets API (service-account auth; see sprintboard §Services) ---
# From the service-account JSON key: client_email + private_key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- (Optional) Google My Maps source for Locations coordinates ---
# Map must be shared "anyone with link can view" for KML export to work.
GOOGLE_MY_MAP_MID=

# --- Admin gate (interim single-password; replaced by roles in Option B) ---
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Firebase Realtime Database & Custom Token Auth (Option B) ---
# Client-side configuration (Firebase Web SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin SDK configuration (Mints Custom Tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
